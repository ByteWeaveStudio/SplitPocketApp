# Copy to .env and fill in. These are server-side secrets — never commit .env
# and never ship these values to the client apps.

ENVIRONMENT=development

# Supabase dashboard → Project Settings → API Keys.
SUPABASE_URL=

# Secret API key (sb_secret_...) — bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# Only needed for legacy projects that sign JWTs with a shared HS256 secret.
# Projects on the current API keys verify tokens via JWKS — leave this empty.
SUPABASE_JWT_SECRET=

# Supabase dashboard → Connect → Connection string, used for migrations
# (uv run python -m app.db.migrate). The "direct" host is IPv6-only; on
# IPv4-only networks use the Session Pooler string instead.
DATABASE_URL=

# JSON array; defaults cover the Vite dev server and Capacitor app schemes
# (iOS uses capacitor://localhost, Android uses https://localhost).
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","capacitor://localhost","https://localhost"]
